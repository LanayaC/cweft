# Secrets — NEVER commit
.env
*.key
credentials*

# Python
__pycache__/
*.pyc
cweft-venv/
.venv/
venv*/

# Backups & scratch
logs_backup/
*_backup*
results/results_backup_*.csv

# Plumbing-test grading output stays local
results/plumbing_test/

# Per-call logs from new runs stay out of the repo. The frozen published
# 504 in logs/published/ are committed.
logs/*
!logs/published/

# Local prompt samples for manual review
samples/
